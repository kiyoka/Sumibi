(ert-deftest sumibi-decisions-non-openai-connection-shows-error-without-network ()
  (dolist (configuration '((gemini nil) (deepseek nil) (local nil)
                          (openai "https://example.invalid/v1")
                          (openai "https://api.openai.com.example.invalid/v1")
                          (openai "http://api.openai.com/v1")
                          (openai "https://api.openai.com:8443/v1")))
    (sumibi-test--decisions-buffer
     (let ((sumibi-provider (car configuration)) messages)
       (setenv "SUMIBI_AI_BASEURL" (cadr configuration))
       (cl-letf (((symbol-function 'message)
                  (lambda (format-string &rest args)
                    (push (apply #'format format-string args) messages)))
                 ((symbol-function 'sumibi--decisions-api-key)
                  (lambda () (ert-fail "Unsupported connection read credentials"))))
         (sumibi-setup-auto-convert-hook)
         (insert "nihongo.") (sumibi-check-particle-trigger)
         (should-not requests)
         (should (= sumibi--decisions-call-count 0))
         (should (= (length messages) 1))
         (should (string-match-p "OpenAI以外" (car messages)))
         (should (eq sumibi--decisions-last-error 'unsupported-provider)))))))

