    (cl-letf (((symbol-function 'url-retrieve)
               (lambda (&rest _args)
                 (setq seen url-request-data seen-headers url-request-extra-headers)
                 response)))
             (let ((cancel (sumibi--decisions-http-post
                            "https://example.invalid"
                            (list (cons "Authorization" (string-to-multibyte "Bearer fake-key")))
