;;; sumibi-decisions-test.el --- Decisions ambient regression tests -*- lexical-binding: t; -*-
;;; Commentary:
;; No credentials, network, or paid requests are used by these tests.
;;; Code:
(require 'ert)
(unless (require 'popup nil t) (provide 'popup))
(unless (require 'unicode-escape nil t)
  (defun unicode-escape (s) s)
  (defun unicode-escape-to-string (s) s)
  (provide 'unicode-escape))
(unless (require 'deferred nil t) (provide 'deferred))
(unless (require 'dash nil t)
  (defun -filter (fn items) (cl-remove-if-not fn items))
  (defun -map (fn items) (mapcar fn items))
  (provide 'dash))
(require 'sumibi)

(defmacro sumibi-test--decisions-buffer (&rest body)
  "Run BODY with fake async transport, conversion and isolated Sumibi state."
  (declare (indent 0))
  `(let ((sumibi-ambient-enable t) (sumibi-mode t)
         (sumibi-ambient-backend 'decisions) (sumibi-select-mode nil)
         (sumibi-ambient-punctuation-delay 0.5)
         (sumibi-history-stack nil) (sumibi-use-fence nil)
         (sumibi-debug nil) (sumibi-henkan-kouho-list nil)
         (sumibi-decisions-debug nil)
         (sumibi-decisions-batch-window-ms 0)
         (sumibi-api-key-source 'environment)
         (sumibi-provider 'openai)
         (sumibi-init t)
         (sumibi-decisions-max-calls-per-buffer 1000)
         (process-environment (copy-sequence process-environment))
         requests conversions)
     (setenv "OPENAI_API_KEY" "test-key")
     (setenv "SUMIBI_AI_BASEURL" nil)
     (cl-letf (((symbol-function 'sumibi--decisions-http-post)
                (lambda (url headers body timeout callback)
                  (push (list url headers body timeout callback) requests)
                  #'ignore))
               ((symbol-function 'sumibi-get-api-key) (lambda () "test-conversion-key"))
               ((symbol-function 'sumibi-roman-to-kanji-with-surrounding)
                (lambda (roman surrounding n deferred &optional callback)
                  (push (list roman surrounding n deferred callback) conversions)
                  #'ignore)))
              (with-temp-buffer
                (unwind-protect (progn ,@body) (sumibi--decisions-stop))))))

(defun sumibi-test--decisions-answer (request score)
  "Complete fake REQUEST with SCORE."
  (funcall (nth 4 request)
           (json-encode `((answers . ,(vector `((type . "predicate")
                                                (name . "convert_now")
                                                (probability . ,score)))))) nil))

(defun sumibi-test--decisions-batch-answer (request scores &optional reverse-order)
  "Answer REQUEST with SCORES, optionally reversing the response order."
  (let* ((payload (json-parse-string (decode-coding-string (nth 2 request) 'utf-8)))
         (questions (append (gethash "questions" payload) nil))
         (answers (cl-mapcar
                   (lambda (question score)
                     (if (eq score 'refusal)
                         `((type . "refusal") (name . ,(gethash "name" question)))
                       `((type . "predicate") (name . ,(gethash "name" question))
                         (probability . ,score)))) questions scores)))
    (funcall (nth 4 request)
             (json-encode `((answers . ,(vconcat (if reverse-order (reverse answers) answers))))) nil)))

(ert-deftest sumibi-decisions-batch-window-is-fixed-and-retains-all-keystrokes ()
  (should (= (default-value 'sumibi-decisions-batch-window-ms) 200))
  (sumibi-test--decisions-buffer
   (let ((sumibi-decisions-batch-window-ms 200) timers events
         (sumibi-decisions-debug t))
     (cl-letf (((symbol-function 'run-with-timer)
                (lambda (delay repeat callback &rest _)
                  (push (list delay repeat callback) timers) 'fake-timer))
               ((symbol-function 'cancel-timer) #'ignore)
               ((symbol-function 'sumibi--decisions-log)
                (lambda (format-string &rest args)
                  (push (apply #'format format-string args) events))))
       (sumibi-setup-auto-convert-hook)
       (dolist (char '(?n ?i ?h))
         (sumibi--decisions-pre-command)
         (insert char) (sumibi-check-particle-trigger))
       (should-not requests)
       (should (= (length timers) 1))
       (should (= (caar timers) 0.2))
       (should (= (length sumibi--decisions-collecting) 3))
       (funcall (nth 2 (car timers)))
       (should (= (length requests) 1))
       (let* ((payload (json-parse-string (decode-coding-string (nth 2 (car requests)) 'utf-8)))
              (states (gethash "states" (json-parse-string (gethash "input" payload))))
              (questions (gethash "questions" payload)))
         (should (equal (mapcar (lambda (state) (gethash "text" state)) (append states nil))
                        '("n" "ni" "nih")))
         (should (= (length questions) 3))
         (should (string-match-p "Ignore every other state" (gethash "instructions" (aref questions 0)))))
       (sumibi-test--decisions-batch-answer (car requests) '(0.1 0.3 0.4) t)
       (should (= (cl-count-if (lambda (event) (string-prefix-p "score=" event)) events) 3))
       (should-not conversions)
       (should-not sumibi--decisions-inflight)))))

(ert-deftest sumibi-decisions-batch-input-checks-deadline-despite-delayed-timer ()
  (dolist (elapsed-us '(200000 274000))
    (sumibi-test--decisions-buffer
     (let ((sumibi-decisions-batch-window-ms 200)
           (now (seconds-to-time 1000)) callbacks old-deadline)
       (cl-letf (((symbol-function 'current-time) (lambda () now))
                 ((symbol-function 'run-with-timer)
                  (lambda (_delay _repeat callback &rest _)
                    (push callback callbacks) 'fake-timer))
                 ((symbol-function 'cancel-timer) #'ignore))
         (insert "n") (sumibi-check-particle-trigger)
         (setq old-deadline sumibi--decisions-window-deadline)
         (setq now (time-add (seconds-to-time 1000) '(0 0 199000)))
         (insert "i") (sumibi-check-particle-trigger)
         (should-not requests)
         (should (= (length sumibi--decisions-collecting) 2))
         (should (equal old-deadline sumibi--decisions-window-deadline))
         ;; Don't execute the timer: the next input must seal the old window.
         (setq now (time-add (seconds-to-time 1000) (list 0 0 elapsed-us)))
         (insert "h") (sumibi-check-particle-trigger)
         (should (= (length requests) 1))
         (should (= (length sumibi--decisions-collecting) 1))
         (should (equal (plist-get (car sumibi--decisions-collecting) :text) "nih"))
         (should (time-less-p old-deadline sumibi--decisions-window-deadline))
         (should (= (length callbacks) 2))
         ;; A late callback from the old timer must not close the new window.
         (funcall (cadr callbacks))
         (should (= (length sumibi--decisions-collecting) 1))
         (sumibi-test--decisions-batch-answer (car requests) '(0.1 0.2))
         (funcall (car callbacks))
         (should (= (length requests) 2))
         (sumibi-test--decisions-batch-answer (car requests) '(0.3))
         (should-not sumibi--decisions-window-deadline))))))

(ert-deftest sumibi-decisions-batch-input-deadline-seals-while-request-active ()
  (sumibi-test--decisions-buffer
   (let ((sumibi-decisions-batch-window-ms 200) (now (seconds-to-time 1000)))
     (cl-letf (((symbol-function 'current-time) (lambda () now))
               ((symbol-function 'run-with-timer) (lambda (&rest _) 'fake-timer))
               ((symbol-function 'cancel-timer) #'ignore))
       (insert "n") (sumibi-check-particle-trigger)
       (sumibi--decisions-flush-window)
       (insert "i") (sumibi-check-particle-trigger)
       (setq now (time-add now '(0 0 274000)))
       (insert "h") (sumibi-check-particle-trigger)
       (should (= (length requests) 1))
       (should (= (length sumibi--decisions-ready-batches) 1))
       (should (= (length sumibi--decisions-collecting) 1))
       (sumibi-test--decisions-batch-answer (car requests) '(0.1))
       (should (= (length requests) 2))
       (sumibi-test--decisions-batch-answer (car requests) '(0.2))
       (sumibi--decisions-flush-window)
       (should (= (length requests) 3))
       (sumibi-test--decisions-batch-answer (car requests) '(0.3))
       (should-not conversions)))))

(ert-deftest sumibi-decisions-batch-applies-only-current-result-and-preserves-undo ()
  (sumibi-test--decisions-buffer
   (let ((sumibi-decisions-batch-window-ms 200))
     (sumibi-setup-auto-convert-hook)
     (buffer-enable-undo)
     (dolist (char (string-to-list "nihongo."))
       (insert char) (sumibi-check-particle-trigger))
     (undo-boundary)
     (sumibi--decisions-flush-window)
     (sumibi-test--decisions-batch-answer (car requests) (make-list 8 1.0) t)
     (should (= (length conversions) 1))
     (should (equal (caar conversions) "nihongo"))
     (funcall (nth 4 (car conversions)) '("日本語") nil)
     (should (equal (buffer-string) "日本語。"))
     (undo-only 1)
     (should (equal (buffer-string) "nihongo.")))))

(ert-deftest sumibi-decisions-batch-keeps-next-window-during-network-and-conversion ()
  (sumibi-test--decisions-buffer
   (let ((sumibi-decisions-batch-window-ms 200))
     (insert "nihongo") (sumibi-check-particle-trigger)
     (sumibi--decisions-flush-window)
     (let ((first (car requests)))
       (insert ".") (sumibi-check-particle-trigger)
       (sumibi--decisions-flush-window)
       (should (= (length requests) 1))
       (should (= (length sumibi--decisions-ready-batches) 1))
       (sumibi-test--decisions-batch-answer first '(1.0))
       (should-not conversions)
       (should (= (length requests) 2)))
     (sumibi-test--decisions-batch-answer (car requests) '(1.0))
     (should conversions)
     (let ((callback (nth 4 (car conversions))))
       (insert "a") (sumibi-check-particle-trigger)
       (sumibi--decisions-flush-window)
       (should (= (length requests) 2))
       (funcall callback '("日本語") nil)
       (should (equal (buffer-string) "nihongo.a"))
       (should (= (length requests) 3)))
     (sumibi-test--decisions-batch-answer (car requests) '(0.1))
     (should-not sumibi--decisions-ready-batches))))

