                    "{\"type\":\"predicate\",\"name\":\"convert_now\",\"probability\":1.1}"
                    "{\"type\":\"predicate\",\"name\":\"convert_now\",\"probability\":true}"
                    "{\"type\":\"predicate\",\"name\":\"other\",\"probability\":0.9}"))
    (should-error (sumibi--decisions-score (concat "{\"answers\":[" answer "]}"))))
  (should-error
   (sumibi--decisions-score
    "{\"answers\":[{\"type\":\"predicate\",\"name\":\"convert_now\",\"probability\":0.9},{\"type\":\"predicate\",\"name\":\"convert_now\",\"probability\":0.1}]}"))
  (should (= 0 (sumibi--decisions-score
                "{\"answers\":[{\"type\":\"predicate\",\"name\":\"convert_now\",\"probability\":0}]}"))))

