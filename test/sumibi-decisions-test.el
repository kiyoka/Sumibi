(ert-deftest sumibi-decisions-auth-fixed-host-and-local-sources ()
  (let ((sumibi-api-key-source 'auth-source-keychain)
        (sumibi-provider 'gemini) (auth-sources '("unrelated")) seen)
    (cl-letf (((symbol-function 'auth-source-search)
               (lambda (&rest args)
                 (setq seen (list args auth-sources))
                 (list (list :secret (lambda () "fake-openai-key"))))))
             (should (equal (sumibi--decisions-api-key) "fake-openai-key"))
             (should (equal (plist-get (car seen) :host) "api.openai.com"))
             (should (equal (plist-get (car seen) :user) "apikey"))
             (should (equal (cadr seen) '(macos-keychain-internet macos-keychain-generic)))
             (should (equal auth-sources '("unrelated"))))))

(ert-deftest sumibi-decisions-auth-does-not-use-foreign-environment-key ()
  (let ((process-environment (copy-sequence process-environment))
        (sumibi-api-key-source 'environment) (sumibi-provider 'gemini))
    (setenv "OPENAI_API_KEY" nil)
    (setenv "SUMIBI_AI_API_KEY" "foreign-key")
    (should-not (sumibi--decisions-api-key))
    (let ((sumibi-provider 'openai))
      (setenv "SUMIBI_AI_BASEURL" "https://example.invalid/v1")
      (should-not (sumibi--decisions-api-key))
      (setenv "SUMIBI_AI_BASEURL" nil)
      (should (equal (sumibi--decisions-api-key) "foreign-key")))
    (setenv "OPENAI_API_KEY" "explicit-openai-key")
    (should (equal (sumibi--decisions-api-key) "explicit-openai-key"))))

(ert-deftest sumibi-decisions-score-rejects-refusals-and-duplicates ()
