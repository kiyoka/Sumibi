(ert-deftest sumibi-decisions-scratch-is-plain-in-lisp-interaction-mode ()
  (sumibi-test--decisions-buffer
   (lisp-interaction-mode)
   (insert "korede jidouhenkan desu.")
   ;; Mock the name so an existing user's *scratch* is never renamed or edited.
   (cl-letf (((symbol-function 'buffer-name) (lambda (&optional _buffer) "*scratch*")))
            (let* ((snapshot (sumibi--decisions-snapshot 500))
                   (payload (json-parse-string
                             (decode-coding-string (sumibi--decisions-payload snapshot) 'utf-8)))
                   (input (gethash "input" payload)))
              (should (equal (plist-get snapshot :context) "plain"))
              (should (= (plist-get snapshot :start) (point-min)))
              (should (equal input (buffer-string)))
              (sumibi--decisions-submit snapshot)
              (sumibi-test--decisions-answer (car requests) 0.95)
              (should (= (length conversions) 1))
              (funcall (nth 4 (car conversions)) '("これで自動変換です") nil)
              (should (equal (buffer-string) "これで自動変換です。"))))))

